# Copy this file to .env and replace values for your host.

#############################
# Compose interpolation     #
#############################

# LLM API binding. The gateway defaults to calling this through
# host.docker.gateway:9900 from its own compose stack.
LLM_HOST=127.0.0.1
LLM_HTTP_PORT=9900

# Smoke test image, built by deploy/build_images.sh, which writes this line.
LLM_SMOKE_TESTS_IMAGE=llm-gateway-smoke-tests:YYYYMMDD-sha

# Host and GPU exporters.
LLM_NODE_EXPORTER_IMAGE=prom/node-exporter:v1.12.1
LLM_NODE_EXPORTER_CONTAINER_NAME=llm-node-exporter
LLM_DCGM_EXPORTER_IMAGE=nvidia/dcgm-exporter:4.8.4
LLM_DCGM_EXPORTER_CONTAINER_NAME=llm-dcgm-exporter

# node-exporter listens in the host network namespace on this port.
# dcgm-exporter is not published at all: llm-vmagent reaches it over the
# compose network.
LLM_NODE_EXPORTER_PORT=9100

#############################
# Metrics -> central VM     #
#############################

# llm-vmagent scrapes node-exporter and dcgm-exporter on this machine and
# pushes them to the central VictoriaMetrics (deploy/observability), so the
# central side never needs this machine's address. Pending samples are kept in
# memory only and dropped if the central side stays down longer than that.
#
# The MACHINE name, stamped as the `host` label. Use the same value as
# GATEWAY_HOST_ID of the gateways on this machine.
LLM_HOST_ID=rtx6000a
LLM_VMAGENT_IMAGE=victoriametrics/vmagent:v1.155.0
LLM_VMAGENT_CONTAINER_NAME=llm-vmagent
LLM_METRICS_PUSH_URL=http://10.0.0.100:8428/api/v1/write

# vLLM backend variant.
LLM_VLLM_IMAGE=vllm/vllm-openai:v0.28.0
LLM_VLLM_CONTAINER_NAME=vllm
LLM_VLLM_MODEL_PATH=/path/to/local/hf/model

# Optional LoRA adapter directory, mounted at /adapter_model.
# Leave empty if no adapter is used; Compose mounts /dev/null at this path instead.
LLM_VLLM_ADAPTER_MODEL_PATH=

# SGLang backend variant.
LLM_SGLANG_IMAGE=lmsysorg/sglang:v0.5.16
LLM_SGLANG_CONTAINER_NAME=sglang
LLM_SGLANG_MODEL_PATH=/path/to/local/hf/model
LLM_SGLANG_SHM_SIZE=32gb

#############################
# Container environment     #
#############################

# Smoke test runner. Used only by llm-smoke-tests with --profile test.
SMOKE_MODEL=local-model
SMOKE_PROMPT=Say pong in one short sentence.
SMOKE_TIMEOUT_SEC=60
SMOKE_API_KEY=
SMOKE_CHECK_TOOLS=false
# Opt-in: assert the backend answers without a reasoning trace. Enable only
# when the launcher runs with DISABLE_THINKING=1 in serve_vllm.sh/serve_sglang.sh.
SMOKE_CHECK_THINKING=false
