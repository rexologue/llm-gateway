# Copy this file to .env and replace values for THIS machine.
#
# One gateway runs per engine process, next to its engine. Everything it
# reports to - Loki, Tempo, Valkey - lives in the central deploy/observability
# stack and is addressed here by IP. The gateway starts and proxies whether or
# not that stack is up; it just records nothing while it is down.

#############################
# Engine identity           #
#############################

# REQUIRED. Names this gateway in every Loki stream (label `engine`) and every
# trace resource (`service.instance.id`). The gateway refuses to start without
# it, because an unset value would silently merge the telemetry of every machine
# into one anonymous heap.
#
# It identifies an ENGINE PROCESS, not a machine: one vLLM process = one port =
# one model, so a machine hosting two engines runs two gateways with two ids.
GATEWAY_ENGINE_ID=rtx6000a-8001

#############################
# Compose interpolation     #
#############################

GATEWAY_HOST=0.0.0.0
GATEWAY_HTTP_PORT=9090
GATEWAY_CONTAINER_NAME=llm-gateway

#############################
# Backend routing           #
#############################

# The engine this gateway sits in front of, on this same machine.
GATEWAY_BACKEND_BASE_URL=http://host.docker.gateway:9900
GATEWAY_FORCED_MAX_COMPLETION_TOKENS=
GATEWAY_FORCED_THINKING_DISABLED=false
GATEWAY_ENABLE_SAMPLING_FALLBACK_OVERRIDE=false

#############################
# Gateway HTTP client       #
#############################

GATEWAY_TIMEOUT_CONNECT_SEC=30
GATEWAY_TIMEOUT_READ_SEC=1800
GATEWAY_TIMEOUT_WRITE_SEC=1800
GATEWAY_TIMEOUT_POOL_SEC=30
GATEWAY_HTTP_MAX_CONNECTIONS=200
GATEWAY_HTTP_MAX_KEEPALIVE_CONNECTIONS=100

#############################
# Session state (central)   #
#############################

# Set false to run a pure proxy: no session persistence, no first-request
# classification, and no Valkey traffic at all. /gateway/session* then answer
# 503. Use it when this gateway runs without the observability stack.
GATEWAY_SESSIONS_ENABLED=true

# The ONE Valkey shared by every gateway (deploy/observability). DB 0 holds
# runtime session keys, DB 1 the stored transcripts. Sharing it is what keeps a
# dialog whole when a round-robin balancer spreads its turns over machines.
GATEWAY_VALKEY_URL=redis://10.0.0.100:6379

GATEWAY_SESSION_KEY_PREFIX=llm-gateway:session:
# Sliding TTL of a runtime session key: how long a quiet session still counts as
# the same session for first-request classification.
GATEWAY_SESSION_TTL=180
GATEWAY_SESSION_TRACKER_MAX_CONNECTIONS=256
GATEWAY_SESSION_STORE_KEY_PREFIX=llm-gateway:session-store:
GATEWAY_SESSION_STORE_TTL=1296000
GATEWAY_SESSION_STORE_MAX_CONNECTIONS=256
GATEWAY_SESSION_STORE_MAX_RECORD_BYTES=4194304
GATEWAY_SESSION_STORE_WRITE_ATTEMPTS=5

# Breaker over every Valkey call. Without it an unreachable Valkey costs the
# 2 s socket timeout twice per chat request - once before the backend call and
# once before the response is returned. After this many consecutive failures the
# gateway stops dialing for the cooldown, then lets one probe through.
GATEWAY_VALKEY_BREAKER_FAILURES=3
GATEWAY_VALKEY_BREAKER_COOLDOWN_SEC=30

#############################
# Backend draining          #
#############################

GATEWAY_DRAIN_AFTER_DISCONNECT=true
GATEWAY_DRAIN_TIMEOUT_SEC=300
GATEWAY_DRAIN_MAX_BYTES=33554432
GATEWAY_FORCE_STREAM_USAGE=true

#############################
# Logs -> central Loki      #
#############################

# Push. Delivery failures are counted (gateway_loki_push_total{status="error"})
# and dropped; they never touch the request path.
GATEWAY_LOKI_ENABLED=true
GATEWAY_LOKI_PUSH_URL=http://10.0.0.100:3100/loki/api/v1/push
# Stays identical on every gateway: the per-engine split is the `engine` label,
# which comes from GATEWAY_ENGINE_ID.
GATEWAY_LOKI_APP_NAME=llm-gateway
GATEWAY_LOKI_BATCH_SIZE=200
GATEWAY_LOKI_FLUSH_INTERVAL_SEC=1.0
GATEWAY_LOKI_QUEUE_MAX_SIZE=10000

#############################
# Metrics -> Monitor        #
#############################

# Monitor is the call platform's metrics sink, owned by another team. It is not
# part of answering a request: records are queued and delivered by background
# workers, so a Monitor that is down costs dropped records and never latency.
#
# Off unless configured. Enabling it without an address is refused at startup,
# because a sink that is on but unreachable reports nothing and says nothing.
GATEWAY_MONITOR_ENABLED=false

# Host only - the gateway reports conversations, so the path (/api/v1/conv) is
# fixed by Monitor's own contract and is not configurable.
GATEWAY_MONITOR_API_URL=https://monitor.ai-mop.ru

# Names this worker in the record. Identical on every gateway: which engine
# answered is `gpu_node`, which comes from GATEWAY_ENGINE_ID.
GATEWAY_MONITOR_SERVICE_NAME=llm-gateway

# Short on purpose. Monitor must never hold a worker long enough for the queue
# to back up behind it.
GATEWAY_MONITOR_TIMEOUT_SEC=1.0
GATEWAY_MONITOR_QUEUE_MAX_SIZE=10000

# Monitor takes one record per POST, so throughput comes from workers rather
# than from batching.
GATEWAY_MONITOR_CONCURRENCY=4

#############################
# Traces -> central Tempo   #
#############################

# Push, through the central OTEL collector. Also identical on every gateway:
# one service with N instances, split by `service.instance.id`.
GATEWAY_OTEL_ENABLED=true
GATEWAY_OTEL_SERVICE_NAME=llm-gateway
GATEWAY_OTEL_EXPORTER_OTLP_ENDPOINT=http://10.0.0.100:4317
GATEWAY_OTEL_SAMPLE_RATIO=1.0
GATEWAY_OTEL_FASTAPI_EXCLUDED_URLS=/gateway/metrics,/metrics,/health,/$

#############################
# Container environment     #
#############################

# Smoke test runner. Used only by gateway-smoke-tests with --profile test.
SMOKE_MODEL=local-model
SMOKE_PROMPT=Say pong in one short sentence.
SMOKE_TIMEOUT_SEC=60
SMOKE_API_KEY=
SMOKE_CHECK_TOOLS=false
# Opt-in: assert the gateway forces thinking off. Enable only when the gateway
# runs with GATEWAY_FORCED_THINKING_DISABLED=true.
SMOKE_CHECK_THINKING=false
