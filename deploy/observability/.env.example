# Copy this file to .env and replace values for your deployment.
#
# This stack runs ONCE for the whole fleet. Engine machines reach it over the
# network, so OBSERVABILITY_HOST must NOT be 127.0.0.1 unless everything runs on
# one box.

#############################
# Binding                   #
#############################

# Address these services are published on. Must be reachable from every machine
# running a gateway.
OBSERVABILITY_HOST=0.0.0.0

#############################
# Session state (Valkey)    #
#############################

# Shared by every gateway: DB 0 holds runtime session keys, DB 1 the stored
# transcripts. One Valkey for the fleet is what keeps a dialog whole when a
# round-robin balancer spreads its turns over several machines.
OBSERVABILITY_VALKEY_IMAGE=valkey/valkey:9.1-alpine
OBSERVABILITY_VALKEY_CONTAINER_NAME=llm-valkey
OBSERVABILITY_VALKEY_PORT=6379
OBSERVABILITY_VALKEY_VOLUME=/path/to/volume/for/valkey

#############################
# Logs (Loki)               #
#############################

OBSERVABILITY_LOKI_IMAGE=grafana/loki:3.7.7
OBSERVABILITY_LOKI_CONTAINER_NAME=llm-loki
OBSERVABILITY_LOKI_HTTP_PORT=3100
OBSERVABILITY_LOKI_VOLUME=/path/to/volume/for/loki

#############################
# Metrics (Prometheus)      #
#############################

# Targets and their engine/host labels live in configs/prometheus.yaml.
OBSERVABILITY_PROMETHEUS_IMAGE=prom/prometheus:latest
OBSERVABILITY_PROMETHEUS_CONTAINER_NAME=llm-prometheus
OBSERVABILITY_PROMETHEUS_HTTP_PORT=9091
OBSERVABILITY_PROMETHEUS_VOLUME=/path/to/volume/for/prometheus

#############################
# Traces (Tempo + OTEL)     #
#############################

OBSERVABILITY_TEMPO_IMAGE=grafana/tempo:3.0.2
OBSERVABILITY_TEMPO_CONTAINER_NAME=llm-tempo
OBSERVABILITY_TEMPO_HTTP_PORT=3200
OBSERVABILITY_TEMPO_VOLUME=/path/to/volume/for/tempo

OBSERVABILITY_OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.158.0
OBSERVABILITY_OTEL_COLLECTOR_CONTAINER_NAME=llm-otel-collector
OBSERVABILITY_OTEL_GRPC_PORT=4317
OBSERVABILITY_OTEL_HEALTH_PORT=13133
